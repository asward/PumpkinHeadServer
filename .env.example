# Copy to .env and adjust. Every setting is listed in pumpkin/config.py.
PUMPKIN_PASSWORD=
PUMPKIN_SERIAL_PORT=/dev/ttyACM0
# Host device compose passes through as the board. With PUMPKIN_SERIAL_PORT=mock, set to /dev/null.
#PUMPKIN_SERIAL_DEVICE=/dev/ttyACM0
PUMPKIN_CANDY_MOTOR=1
PUMPKIN_CANDY_STEPS=200
PUMPKIN_CANDY_SPEED=800
PUMPKIN_EYES_PIN=17
PUMPKIN_MOUTH_PIN=27
# single = one on/off pin; hbridge = MOUTH_PIN opens (IN1), MOUTH_CLOSE_PIN closes (IN2)
#PUMPKIN_MOUTH_DRIVER=hbridge
#PUMPKIN_MOUTH_CLOSE_PIN=22
#PUMPKIN_MOUTH_CLOSE_MS=150
# H-bridge EN/ENA pin, -1 = jumpered
#PUMPKIN_MOUTH_ENABLE_PIN=23
# While the mouth is on, open/close cycles per second (0 = hold open)
#PUMPKIN_MOUTH_FLAP_HZ=4
# Limit switch, normally open to GND (-1 = none); back off for N flap cycles on a hit
#PUMPKIN_MOUTH_LIMIT_PIN=24
#PUMPKIN_MOUTH_LIMIT_BACKOFF_CYCLES=10
PUMPKIN_GPIO_CHIP=0
PUMPKIN_AUDIO_DEVICE=
# v4l2 = USB webcam, rpicam = Pi CSI (ribbon) camera
PUMPKIN_CAMERA_SOURCE=v4l2
PUMPKIN_CAMERA_DEVICE=/dev/video0
# CSI cameras have no microphone: leave empty unless you add a USB mic.
PUMPKIN_CAMERA_AUDIO_DEVICE=plughw:CARD=Camera,DEV=0
# For a CSI camera, uncomment to add docker-compose.rpicam.yml:
#COMPOSE_FILE=docker-compose.yml:docker-compose.rpicam.yml
